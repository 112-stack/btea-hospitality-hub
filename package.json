{
  "name": "btea-web-portal",
  "version": "2.1.0",
  "description": "Independent preservation and local-safe workflow demonstration of public BTEA e-services",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "mobile:build": "vite build && node scripts/prepare-mobile.mjs",
    "native:sync": "npm run mobile:build && cap sync",
    "native:assets": "npx --yes @capacitor/assets@3.0.5 generate --iconBackgroundColor '#815374' --iconBackgroundColorDark '#2b1b26' --splashBackgroundColor '#f7f3f6' --splashBackgroundColorDark '#211a20'",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "store:audit": "node scripts/verify-store-readiness.mjs",
    "preview": "vite preview",
    "serve": "node server.mjs",
    "dev:api": "node server.mjs --port 4174",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint src scripts server.mjs server.test.mjs --ext js,jsx,mjs --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "analyze": "vite-bundle-visualizer"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@headlessui/react": "^1.7.18",
    "@heroicons/react": "^2.1.1",
    "@hookform/resolvers": "^3.3.4",
    "@tanstack/react-query": "^5.20.0",
    "@tanstack/react-table": "^8.11.0",
    "chart.js": "^4.4.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.0",
    "date-fns": "^3.3.1",
    "framer-motion": "^11.0.3",
    "i18next": "^23.8.2",
    "lucide-react": "^0.323.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-countup": "^6.5.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.50.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^14.0.5",
    "react-icons": "^5.0.1",
    "react-intersection-observer": "^9.8.0",
    "react-resizable-panels": "^2.0.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.0",
    "sonner": "^1.4.0",
    "vaul": "^0.9.0",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "@vitest/ui": "^1.2.2",
    "autoprefixer": "^10.4.17",
    "daisyui": "^4.7.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0",
    "vite-bundle-visualizer": "^1.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^1.2.2"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
